# Alertmanager: принимает алерты от Prometheus и рассылает на email.
# Пароли/адреса берутся из переменных окружения (--config.expand-env),
# которые задаются в .env на машине-генераторе (см. .env.example).
global:
  resolve_timeout: 5m

route:
  receiver: email
  # Группируем по серверу и приложению: в одном письме — все сбои одной
  # машины, а не смесь IP-адресов в одну кучу.
  group_by: ["alertname", "server", "app"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 3h

receivers:
  - name: email
    email_configs:
      - to: "${ALERT_EMAIL_TO}"
        from: "${ALERT_EMAIL_FROM}"
        smarthost: "${SMTP_HOST}:${SMTP_PORT}"
        auth_username: "${SMTP_USER}"
        auth_password: "${SMTP_PASSWORD}"
        require_tls: true
        send_resolved: true
        headers:
          # Тема: сначала что случилось, потом ЧЕЙ это сервер.
          # server — отображаемое имя из .env (APPS_SERVER_NAME и т.д.);
          # fallback на instance нужен на случай алерта без этого лейбла.
          Subject: >-
            [{{ if eq .Status "firing" }}{{ .CommonLabels.severity | toUpper }}{{ else }}РЕШЕНО{{ end }}]
            {{ .CommonLabels.server | default .CommonLabels.instance }}:
            {{ if eq .Status "firing" }}{{ .CommonLabels.alertname }}{{ else }}восстановлен {{ .CommonLabels.alertname }}{{ end }}
