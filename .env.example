# Скопируйте в .env и поправьте под свою схему.
# Из этого файла берутся ВСЕ таргеты Prometheus и реквизиты алертов —
# дублировать IP в prometheus/prometheus.yml не нужно.

# --- Хосты ---
# Сервер приложений chat + makeup.
APPS_HOST=168.222.194.206
# Сервер world-country-monitoring (там же по умолчанию живёт сам мониторинг).
WCM_HOST=89.104.66.226
# Старый сервер akm (gitlab, инфраструктура) — только метрики хоста и ICMP.
AKM_HOST=90.188.89.63

# --- Порты приложений ---
MAKEUP_PORT=8085
CHAT_PORT=8086
WCM_PORT=8087

# --- node_exporter: адреса на хосте мониторинга ---
# Реальные node_exporter на серверах слушают только 127.0.0.1:9100 и видны
# через SSH-туннели (см. server/*.service). Prometheus скрейпит эти адреса.
AKM_NODE_EXPORTER_PORT=9100
WCM_NODE_EXPORTER_PORT=9101
APPS_NODE_EXPORTER_PORT=9102

# --- SSH-туннели к серверам приложений ---
# Нужны, чтобы node_exporter был виден и чтобы Loki принимал логи promtail'а.
# Ключ с машины мониторинга должен быть в authorized_keys на сервере приложений.
APPS_SSH_TARGET=root@168.222.194.206
APPS_SSH_PORT=22
APPS_SSH_KEY=/root/.ssh/id_ed25519

# --- Loki ---
# Prometheus/Grafana читают Loki локально; promtail на серверах приложений
# шлёт в 127.0.0.1:3100, куда его пробрасывает обратный туннель с этой машины.
LOKI_PORT=3100

# --- Grafana ---
GRAFANA_BIND_ADDR=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Наружу торчит только Grafana, и только через обратный прокси с TLS.
GRAFANA_ANONYMOUS_ENABLED=false

# --- Prometheus ---
# Куда k6-тесты из репозитория loadtest пишут свои метрики (remote write).
# Прогоняющий хост должен иметь сетевой доступ к этому адресу.
K6_REMOTE_WRITE_URL=http://127.0.0.1:9090/api/v1/write

# --- Email-алерты (Alertmanager) ---
# Gmail: включите 2FA и создайте App Password (обычный пароль не подойдёт).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_FROM=you@gmail.com
ALERT_EMAIL_TO=you@gmail.com
