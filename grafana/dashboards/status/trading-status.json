    "trading",
    "status",
    "containers",
    "sessions"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
