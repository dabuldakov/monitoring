      "id": 1,
      "type": "stat",
      "title": "Сессии (running)",
      "description": "trading_sessions_running_total — живые сессии стратегий.",
      "datasource": {
        "type": "prometheus",
        "uid": "ds_prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "value"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ds_prometheus"
          },
          "expr": "trading_sessions_running_total",
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "transformations": []
    },
