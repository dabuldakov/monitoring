{
  "uid": "network-path",
  "title": "Network path (generator -> server)",
  "tags": ["network", "k6"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "ICMP success (1=ok, 0=lost)",
      "datasource": { "type": "prometheus", "uid": "ds_prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "max": 1, "custom": { "fillOpacity": 10, "showPoints": "always" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "probe_success{job=\"blackbox-icmp\"}", "legendFormat": "icmp {{instance}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "ICMP RTT",
      "datasource": { "type": "prometheus", "uid": "ds_prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "probe_duration_seconds{job=\"blackbox-icmp\"}", "legendFormat": "rtt {{instance}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "ICMP loss rate (1m)",
      "datasource": { "type": "prometheus", "uid": "ds_prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "1 - avg_over_time(probe_success{job=\"blackbox-icmp\"}[1m])", "legendFormat": "loss {{instance}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "TCP connect success",
      "datasource": { "type": "prometheus", "uid": "ds_prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "max": 1, "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "probe_success{job=\"blackbox-tcp\"}", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "TCP connect time",
      "datasource": { "type": "prometheus", "uid": "ds_prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "probe_duration_seconds{job=\"blackbox-tcp\"}", "legendFormat": "{{instance}}" }
      ]
    }
  ]
}
