{
  "uid": "muzea-instances",
  "title": "Muzea — инстансы",
  "tags": [
    "muzea",
    "instances"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Схема",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "```\nhost nginx :443\n ├─ makeup nginx :8085 → makeup-app · makeup-app-2\n ├─ chat nginx   :8086 → chat-app   · chat-app-2\n └─ auth nginx   :8087 → auth-app   · auth-app-2\n\nPostgreSQL · Redis · MinIO — общие для обоих инстансов\n```"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "makeup: инстансы UP",
      "datasource": {
        "type": "prometheus",
        "uid": "ds_prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ds_prometheus"
          },
          "expr": "sum(up{job=\"app-makeup\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "0 / 2",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "1 / 2",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "2 / 2",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
