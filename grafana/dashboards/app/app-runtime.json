{
  "uid": "app-runtime",
  "title": "App Runtime (Micrometer)",
  "tags": [
    "app",
    "micrometer",
    "prometheus"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Приложения: скрейп",
      "description": "up по джобам app-makeup/app-chat/app-auth. 1 — метрики снимаются, 0 — нет.",
      "datasource": {
        "type": "prometheus",
        "uid": "ds_prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ds_prometheus"
          },
          "expr": "up{job=~\"app-(makeup|chat|auth)\"}",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP RPS по приложениям",
      "description": "Суммарный RPS всех эндпоинтов, включая 4xx/5xx.",
      "datasource": {
        "type": "prometheus",
        "uid": "ds_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ds_prometheus"
          },
          "expr": "sum by (app) (rate(http_server_requests_seconds_count{job=~\"app-.*\"}[$__rate_interval]))",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 HTTP-латентности",
      "description": "histogram_quantile(0.95) по http_server_requests. Стриминг видео и actuator исключены: долгий стрим искажает p95 обычных API-запросов.",
      "datasource": {
        "type": "prometheus",
        "uid": "ds_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ds_prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, app) (rate(http_server_requests_seconds_bucket{job=~\"app-.*\", uri!~\"/api/videos/stream/.*|/actuator/.*\"}[$__rate_interval])))",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ошибки 5xx (RPS)",
      "description": "Ответы 5xx по приложениям. Алерт AppHighErrorRate срабатывает при доле > 2%.",
      "datasource": {
        "type": "prometheus",
        "uid": "ds_prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ds_prometheus"
          },
          "expr": "sum by (app) (rate(http_server_requests_seconds_count{job=~\"app-.*\", status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{app}} 5xx"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "JVM heap",
      "description": "Использованный heap по приложениям.",
      "datasource": {
        "type": "prometheus",
        "uid": "ds_prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ds_prometheus"
          },
          "expr": "max by (app) (jvm_memory_used_bytes{job=~\"app-.*\", area=\"heap\"})",
          "legendFormat": "{{app}} used"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ds_prometheus"
          },
          "expr": "max by (app) (jvm_memory_max_bytes{job=~\"app-.*\", area=\"heap\"})",
          "legendFormat": "{{app}} max"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Hikari: активные и ожидающие соединения",
      "description": "pending > 0 — запросы стоят в очереди за соединением к БД.",
      "datasource": {
        "type": "prometheus",
        "uid": "ds_prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ds_prometheus"
          },
          "expr": "max by (app) (hikaricp_connections_active{job=~\"app-.*\"})",
          "legendFormat": "{{app}} active"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ds_prometheus"
          },
          "expr": "max by (app) (hikaricp_connections_pending{job=~\"app-.*\"})",
          "legendFormat": "{{app}} pending"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tomcat: занятые HTTP-потоки",
      "description": "Приближение к tomcat_threads_config_max_threads — упор в конкурентность.",
      "datasource": {
        "type": "prometheus",
        "uid": "ds_prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ds_prometheus"
          },
          "expr": "max by (app) (tomcat_threads_busy_threads{job=~\"app-.*\"})",
          "legendFormat": "{{app}} busy"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ds_prometheus"
          },
          "expr": "max by (app) (tomcat_threads_config_max_threads{job=~\"app-.*\"})",
          "legendFormat": "{{app}} max"
        }
      ]
    }
  ]
}
