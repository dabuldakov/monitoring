{
  "uid": "backend-logs",
  "title": "Backend Logs",
  "tags": ["logs", "backend", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "app",
        "type": "query",
        "datasource": { "type": "loki", "uid": "ds_loki" },
        "definition": "label_values(app)",
        "query": "label_values(app)",
        "allValue": ".+",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "level",
        "label": "level",
        "type": "query",
        "datasource": { "type": "loki", "uid": "ds_loki" },
        "definition": "label_values(level)",
        "query": "label_values(level)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "user",
        "label": "user (regex)",
        "type": "textbox",
        "query": ".*",
        "current": { "selected": false, "text": ".*", "value": ".*" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Logs",
      "description": "Живой поток логов. Фильтры: app / level (метки) и user (regex по JSON-полю).",
      "datasource": { "type": "loki", "uid": "ds_loki" },
      "gridPos": { "h": 15, "w": 24, "x": 0, "y": 0 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "ds_loki" },
          "expr": "{app=~\"$app\", level=~\"$level\"} | json | user=~\"$user\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errors (range)",
      "datasource": { "type": "loki", "uid": "ds_loki" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "ds_loki" },
          "expr": "sum(count_over_time({app=~\"$app\", level=\"ERROR\"} [$__range]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Warnings (range)",
      "datasource": { "type": "loki", "uid": "ds_loki" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "ds_loki" },
          "expr": "sum(count_over_time({app=~\"$app\", level=\"WARN\"} [$__range]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Log lines (range)",
      "datasource": { "type": "loki", "uid": "ds_loki" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 15 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "none" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "ds_loki" },
          "expr": "sum(count_over_time({app=~\"$app\", level=~\"$level\"} [$__range]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errors / min by app",
      "datasource": { "type": "loki", "uid": "ds_loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "ds_loki" },
          "expr": "sum by (app) (count_over_time({app=~\"$app\", level=\"ERROR\"} [$__interval]))",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Warnings / min by app",
      "datasource": { "type": "loki", "uid": "ds_loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "ds_loki" },
          "expr": "sum by (app) (count_over_time({app=~\"$app\", level=\"WARN\"} [$__interval]))",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Log volume by level",
      "datasource": { "type": "loki", "uid": "ds_loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "stacking": { "mode": "normal" }, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "ds_loki" },
          "expr": "sum by (level) (count_over_time({app=~\"$app\"} [$__interval]))",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Trading logs",
      "description": "Логи сервера trading: инфраструктура (app=trading) и live-трейдеры (app=trader).",
      "datasource": { "type": "loki", "uid": "ds_loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 36 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "ds_loki" },
          "expr": "{app=~\"trading|trader\"}",
          "queryType": "range"
        }
      ]
    }
  ]
}
